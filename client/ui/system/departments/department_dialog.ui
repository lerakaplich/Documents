/* ===== СТИЛИ ДЛЯ QGroupBox ===== */
QGroupBox {
    font-weight: bold;
    font-size: 14px;
    border: 1px solid {BORDER_DEFAULT};
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 10px;
    background-color: {BG_CARD};
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px 0 5px;
    color: {TEXT_PRIMARY};
}

/* ===== СТИЛИ ДЛЯ QPushButton (Сохранить) ===== */
QPushButton#saveButton {
    background-color: {ACCENT_PRIMARY};
