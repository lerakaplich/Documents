}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* ===== СТИЛИ ДЛЯ QComboBox ===== */
QComboBox {
    border: 1px solid {BORDER_DEFAULT};
    border-radius: 6px;
    padding: 6px;
    padding-right: 30px;
    background-color: {BG_INPUT};
    color: {TEXT_PRIMARY};
    font-size: 13px;
    outline: none;
    min-height: 22px;
}

QComboBox:hover {
    border-color: {ACCENT_PRIMARY};
}

QComboBox:focus {
    border: 2px solid {ACCENT_PRIMARY};
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border: none;
}

QComboBox::down-arrow {
    image: url({ICON_ARROW_DOWN_PATH});
    width: 16px;
    height: 16px;
    margin-right: 6px;
}

QComboBox QAbstractItemView {
    border-radius: 6px;
    background-color: {BG_CARD};
    color: {TEXT_PRIMARY};
    padding: 4px;
    outline: none;
    border: 1px solid {ACCENT_PRIMARY};
}

QComboBox QAbstractItemView::item {
    padding: 8px;
    color: {TEXT_PRIMARY};
    border: none;
    outline: none;
}

QComboBox QAbstractItemView::item:hover {
    background-color: {ACCENT_SELECTION_BG};
    color: {TEXT_PRIMARY};
}

QComboBox QAbstractItemView::item:selected {
    background-color: {ACCENT_SELECTION_BG};
    color: {TEXT_PRIMARY};
}

/* ===== СТИЛИ ДЛЯ QDateEdit ===== */
QDateEdit {
    border: 1px solid {BORDER_DEFAULT};
    border-radius: 6px;
    padding: 6px;
    padding-right: 30px;
    background-color: {BG_INPUT};
    color: {TEXT_PRIMARY};
    font-size: 13px;
    outline: none;
    min-height: 22px;
}

QDateEdit:hover {
    border-color: {ACCENT_PRIMARY};
}

QDateEdit:focus {
    border: 2px solid {ACCENT_PRIMARY};
}

QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border: none;
}

QDateEdit::down-arrow {
    image: url({ICON_CALENDAR_PATH});
    width: 18px;
    height: 18px;
    margin-right: 8px;
}

/* ===== СТИЛИ ДЛЯ QLineEdit ===== */
QLineEdit {
    border: 1px solid {BORDER_DEFAULT};
    border-radius: 6px;
    padding: 6px;
    background-color: {BG_INPUT};
    color: {TEXT_PRIMARY};
    font-size: 13px;
    outline: none;
    min-height: 22px;
}

QLineEdit:hover {
    border-color: {ACCENT_PRIMARY};
}

QLineEdit:focus {
    border: 2px solid {ACCENT_PRIMARY};
}

QLineEdit:disabled {
    background-color: {BG_DIALOG};
    color: {TEXT_SECONDARY};
    border-color: {BORDER_DEFAULT};
}

QLineEdit[readOnly=&quot;true&quot;] {
    background-color: {BG_DIALOG};
    color: {TEXT_SECONDARY};
}

/* ===== СТИЛИ ДЛЯ КАЛЕНДАРЯ QCalendarWidget ===== */
QCalendarWidget {
    background-color: {BG_CARD};
    border-radius: 8px;
    border: 1px solid {ACCENT_PRIMARY};
}

QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: {BG_CARD};
    color: {TEXT_PRIMARY};
    border-radius: 8px 8px 0 0;
}

QCalendarWidget QWidget {
    background-color: {BG_CARD};
    color: {TEXT_PRIMARY};
}

QCalendarWidget QToolButton#qt_calendar_prevmonth,
QCalendarWidget QToolButton#qt_calendar_nextmonth {
    background-color: transparent;
    color: {TEXT_PRIMARY};
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 16px;
    font-weight: bold;
}

QCalendarWidget QToolButton#qt_calendar_prevmonth:hover,
QCalendarWidget QToolButton#qt_calendar_nextmonth:hover {
    background-color: {ACCENT_SELECTION_BG};
}

QCalendarWidget QToolButton#qt_calendar_monthbutton,
QCalendarWidget QToolButton#qt_calendar_yearbutton {
    background-color: {BG_CARD};
    color: {TEXT_PRIMARY};
    border: none;
    border-radius: 4px;
    padding: 4px 12px;
    font-weight: bold;
}

QCalendarWidget QToolButton#qt_calendar_monthbutton:hover,
QCalendarWidget QToolButton#qt_calendar_yearbutton:hover {
    background-color: {ACCENT_SELECTION_BG};
}

QCalendarWidget QMenu {
    background-color: {BG_CARD};
    border: 1px solid {ACCENT_PRIMARY};
    border-radius: 6px;
    color: {TEXT_PRIMARY};
}

QCalendarWidget QMenu::item {
    padding: 6px 20px;
    border-radius: 4px;
}

QCalendarWidget QMenu::item:selected {
    background-color: {ACCENT_SELECTION_BG};
    color: {TEXT_PRIMARY};
}

QCalendarWidget QWidget#qt_calendar_weekday {
    color: {TEXT_ON_ACCENT};
    font-weight: bold;
    background-color: {ACCENT_PRIMARY};
    padding: 4px;
}

