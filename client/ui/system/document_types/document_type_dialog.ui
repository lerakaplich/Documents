  <property name="styleSheet">
   <string notr="true">QScrollArea {
 border: none;
 background-color: transparent;
}
QDialog {
    background-color: #f8f9fa;
}
QCheckBox {
    color: #1B232A;
    spacing: 0px;
    font-size: 13px;
    background: transparent;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    image: url(&quot;D:/Documents/client/icons/cb_unchecked.svg&quot;);
}

QCheckBox::indicator:checked {
    image: url(&quot;D:/Documents/client/icons/cb_checked.svg&quot;);
}

QScrollBar::vertical {
    background: #F5F5F5;
    width: 8px;
    border-radius: 4px;
    margin: 0px;
    border: none;
}

QScrollBar::handle:vertical {
    background: #C1C1C1;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #A0A0A0;
}

QScrollBar::handle:vertical:pressed {
    background: #888888;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    border: none;
    background: none;
    width: 0px;
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background: #F5F5F5;
    height: 8px;
    margin: 0px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: #C1C1C1;
    border-radius: 4px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background: #A0A0A0;
}

QScrollBar::handle:horizontal:pressed {
    background: #888888;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
    width: 0px;
    height: 0px;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* ===== СТИЛИ ДЛЯ QLineEdit ===== */
QLineEdit {
    border: 1px solid #dee2e6;
    border-radius: 6px;
    padding: 8px;
    background-color: white;
    color: #1B232A;
    font-size: 13px;
}

QLineEdit:hover {
    border-color: #ccab6e;
}

QLineEdit:focus {
    border: 2px solid #ccab6e;
}

QLineEdit:read-only {
    background-color: #f5f5f5;
    color: #6c757d;
}

/* ===== СТИЛИ ДЛЯ QGroupBox ===== */
QGroupBox {
    font-weight: bold;
    font-size: 14px;
    border: 1px solid #dee2e6;
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 10px;
    background-color: white;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px 0 5px;
    color: #1B232A;
}

/* ===== СТИЛИ ДЛЯ QPushButton ===== */
QPushButton {
    border: none;
    border-radius: 6px;
    font-weight: bold;
    font-size: 13px;
    padding: 8px 16px;

}

/* Кнопка Обзор и Очистить */
QPushButton#browseBtn,
QPushButton#clearBtn {
    background-color: #f8f9fa;
    color: #1B232A;
    border: 1px solid #dee2e6;
}

QPushButton#browseBtn:hover,
QPushButton#clearBtn:hover {
    background-color: #e9ecef;
    border-color: #ccab6e;
}

QPushButton#browseBtn:pressed,
QPushButton#clearBtn:pressed {
    background-color: #dee2e6;
}

/* Кнопка Сохранить */
QPushButton#saveButton {
    background-color: #ccab6e;
    color: white;
    border-radius: 8px;
    font-weight: bold;
    font-size: 14px;
    border: none;

}

QPushButton#saveButton:hover {
    background-color: #b8945a;
}

QPushButton#saveButton:pressed {
    background-color: #a07d4a;
}

/* Toggle Switch для параметров */
QPushButton#toggleBtn {

    border-radius: 13px;
    font-size: 11px;
    font-weight: bold;
    margin: 0px;
    padding: 0px;
}

QPushButton#toggleBtn:disabled {
    opacity: 0.7;
}

/* ===== СТИЛИ ДЛЯ QFrame ===== */
QFrame#paramFrame {
    border: 1px solid #e9ecef;
    border-radius: 6px;
    background-color: white;
    margin: 2px 0px;
}

QFrame#paramFrame:hover {
    border-color: #ccab6e;
    background-color: #fdfcf7;
}

/* ===== СТИЛИ ДЛЯ QLabel ===== */
QLabel {
    color: #1B232A;
}

QLabel#titleLabel {
    font-size: 22px;
    font-weight: bold;
    color: #1B232A;
    margin-bottom: 10px;
}

QLabel#sectionLabel {
    font-weight: bold;
    color: #1B232A;
    margin-top: 8px;
    font-size: 13px;
}

QLabel#paramNameLabel {
    font-weight: 500;
    color: #1B232A;
    font-size: 13px;
}

/* Акцент на обязательных полях */
QLabel[required=&quot;true&quot;] {
    color: #ccab6e;
}

QLabel[required=&quot;true&quot;]::after {
    content: &quot; *&quot;;
    color: #dc3545;
    font-weight: bold;
}</string>
