  <property name="styleSheet">
   <string notr="true">QScrollArea {
    border: none;
    background-color: transparent;
}
QDialog {
    background-color: {BG_DIALOG};
}
QCheckBox {
    color: {TEXT_PRIMARY};
    spacing: 0px;
    font-size: 13px;
    background: transparent;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    image: url({ICON_CHECKBOX_UNCHECKED_PATH});
}
QCheckBox::indicator:checked {
    image: url({ICON_CHECKBOX_CHECKED_PATH});
}

/* --- скроллбары --- */
QScrollBar::vertical {
    background: {SCROLLBAR_BG};
    width: 8px;
    border-radius: 4px;
    margin: 0px;
    border: none;
}
QScrollBar::handle:vertical {
    background: {SCROLLBAR_HANDLE};
    border-radius: 4px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover { background: {SCROLLBAR_HANDLE_HOVER}; }
QScrollBar::handle:vertical:pressed { background: {SCROLLBAR_HANDLE_PRESSED}; }
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    border: none; background: none; width: 0px; height: 0px;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical { background: none; }

QScrollBar:horizontal {
    border: none;
    background: {SCROLLBAR_BG};
    height: 8px;
    margin: 0px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal {
    background: {SCROLLBAR_HANDLE};
    border-radius: 4px;
    min-width: 20px;
}
QScrollBar::handle:horizontal:hover { background: {SCROLLBAR_HANDLE_HOVER}; }
QScrollBar::handle:horizontal:pressed { background: {SCROLLBAR_HANDLE_PRESSED}; }
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    border: none; background: none; width: 0px; height: 0px;
}
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal { background: none; }

QLineEdit {
    border: 1px solid {BORDER_DEFAULT};
    border-radius: 6px;
    padding: 8px;
    background-color: {BG_INPUT};
    color: {TEXT_PRIMARY};
    font-size: 13px;
}
QLineEdit:hover { border-color: {ACCENT_PRIMARY}; }
QLineEdit:focus { border: 2px solid {ACCENT_PRIMARY}; }
QLineEdit:read-only {
    background-color: {BG_INPUT_READONLY};
    color: {TEXT_MUTED_ALT};
}

QGroupBox {
    font-weight: bold;
    font-size: 14px;
    border: 1px solid {BORDER_DEFAULT};
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 10px;
    background-color: {BG_CARD};
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px 0 5px;
    color: {TEXT_PRIMARY};
}

QPushButton {
    border: none;
    border-radius: 6px;
    font-weight: bold;
    font-size: 13px;
    padding: 8px 16px;
}

QPushButton#browseBtn,
QPushButton#clearBtn {
    background-color: {BG_DIALOG};
    color: {TEXT_PRIMARY};
    border: 1px solid {BORDER_DEFAULT};
}
QPushButton#browseBtn:hover,
QPushButton#clearBtn:hover {
    background-color: {BG_HOVER_ALT};
    border-color: {ACCENT_PRIMARY};
}
QPushButton#browseBtn:pressed,
QPushButton#clearBtn:pressed {
    background-color: {BORDER_DEFAULT};
}

QPushButton#saveButton {
    background-color: {ACCENT_PRIMARY};
    color: {TEXT_ON_ACCENT};
    border-radius: 8px;
    font-weight: bold;
    font-size: 14px;
    border: none;
}
QPushButton#saveButton:hover { background-color: {ACCENT_HOVER}; }
QPushButton#saveButton:pressed { background-color: {ACCENT_PRESSED}; }

QPushButton#toggleBtn {
    border-radius: 13px;
    font-size: 11px;
    font-weight: bold;
    margin: 0px;
    padding: 0px;
}
QPushButton#toggleBtn:disabled { opacity: 0.7; }

QFrame#paramFrame {
    border: 1px solid {BORDER_FRAME_SOFT};
    border-radius: 6px;
    background-color: {BG_CARD};
    margin: 2px 0px;
}
QFrame#paramFrame:hover {
    border-color: {ACCENT_PRIMARY};
    background-color: {BG_HOVER_ACCENT_SOFT};
}

QLabel { color: {TEXT_PRIMARY}; }
QLabel#titleLabel {
    font-size: 22px;
    font-weight: bold;
    color: {TEXT_PRIMARY};
    margin-bottom: 10px;
}
QLabel#sectionLabel {
    font-weight: bold;
    color: {TEXT_PRIMARY};
    margin-top: 8px;
    font-size: 13px;
}
QLabel#paramNameLabel {
    font-weight: 500;
    color: {TEXT_PRIMARY};
    font-size: 13px;
}

QLabel[required="true"] { color: {ACCENT_PRIMARY}; }
QLabel[required="true"]::after {
    content: " *";
    color: {ACCENT_REQUIRED};
    font-weight: bold;
}</string>
