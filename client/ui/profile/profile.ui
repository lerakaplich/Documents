  <property name="styleSheet">
   <string notr="true">
QWidget {
    background-color: {BG_DIALOG_ALT};
    font-family: 'Segoe UI', Arial;
}

QFrame#infoFrame {
    background-color: {BG_CARD};
    border-radius: 16px;
    border: 1px solid {BORDER_LIGHT};
}

QTabWidget::pane {
    border: 1px solid {BORDER_DEFAULT};
    border-radius: 8px;
    background-color: {BG_CARD};
}
QTabBar::tab {
    background-color: {BG_SURFACE_HEADER};
    border: 1px solid {BORDER_DEFAULT};
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 10px 20px;
    margin-right: 5px;
    font-size: 13px;
    font-weight: bold;
    color: {TEXT_BLACK};
}
QTabBar::tab:selected {
    background-color: {BG_CARD};
    border-bottom: 2px solid {ACCENT_PRIMARY};
    color: {TEXT_BLACK};
}
QTabBar::tab:hover {
    background-color: {BG_HOVER_ALT};
    color: {TEXT_BLACK};
}

/* Кнопки */

QPushButton#btnAddOvertime {
    background-color: {ACCENT_PRIMARY};
    color: {TEXT_ON_ACCENT};
    border-radius: 8px;
    font-weight: bold;
    font-size: 13px;
    border: none;
    padding: 0px 16px;
}
QPushButton#btnAddOvertime:hover {
    background-color: {ACCENT_HOVER_SOFT};
}
QPushButton#btnAddOvertime:pressed {
    background-color: {ACCENT_PRESSED_DEEP};
}

QPushButton#btnAddOvertimeAll {
    background-color: {ACCENT_PRIMARY};
    color: {TEXT_ON_ACCENT};
    border-radius: 8px;
    font-weight: bold;
    font-size: 13px;
    border: none;
    padding: 0px 16px;
}
QPushButton#btnAddOvertimeAll:hover {
    background-color: {ACCENT_HOVER_SOFT};
}
QPushButton#btnAddOvertimeAll:pressed {
    background-color: {ACCENT_PRESSED_DEEP};
}

QPushButton#btnSelectPeriod,
QPushButton#btnSelectPeriodAll,
QPushButton#btnApplyFilters,
QPushButton#btnClearFilters,
QPushButton#btnImport {
    background-color: {BTN_DARK_BG};
    color: {TEXT_ON_ACCENT};
    border-radius: 8px;
    font-weight: bold;
    font-size: 13px;
    border: none;
    padding: 0px 16px;
}
QPushButton#btnSelectPeriod:hover,
QPushButton#btnSelectPeriodAll:hover,
QPushButton#btnApplyFilters:hover,
QPushButton#btnClearFilters:hover,
QPushButton#btnImport:hover {
    background-color: {BTN_DARK_HOVER_BG};
    color: {TEXT_BLACK};
}
QPushButton#btnSelectPeriod:pressed,
QPushButton#btnSelectPeriodAll:pressed,
QPushButton#btnApplyFilters:pressed,
QPushButton#btnClearFilters:pressed,
QPushButton#btnImport:pressed {
    background-color: {BTN_DARK_PRESSED_BG};
}

QPushButton#btnExport {
    background-color: {ACCENT_DANGER};
    color: {TEXT_ON_ACCENT};
    border-radius: 8px;
    font-weight: bold;
    font-size: 13px;
    border: none;
    padding: 0px 16px;
}
QPushButton#btnExport:hover {
    background-color: {ACCENT_DANGER_HOVER};
}
QPushButton#btnExport:pressed {
    background-color: {ACCENT_DANGER_PRESSED};
}

QPushButton#btnResetFilters,
QPushButton#btnResetFiltersAll {
    background-color: {ACCENT_PRIMARY};
    color: {TEXT_ON_ACCENT};
    border-radius: 8px;
    font-weight: bold;
    font-size: 13px;
    border: none;
    padding: 0px 16px;
}
QPushButton#btnResetFilters:hover,
QPushButton#btnResetFiltersAll:hover {
    background-color: {ACCENT_HOVER_SOFT};
}
QPushButton#btnResetFilters:pressed,
QPushButton#btnResetFiltersAll:pressed {
    background-color: {ACCENT_PRESSED_DEEP};
}

QComboBox {
    border: 1px solid {BORDER_DEFAULT};
    border-radius: 6px;
    padding: 8px;
    padding-right: 25px;
    background-color: {BG_INPUT};
    color: {TEXT_PRIMARY};
    font-size: 13px;
    outline: none;
}
QComboBox:hover {
    border-color: {ACCENT_PRIMARY};
}
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox::down-arrow {
    image: none;
    border: none;
    width: 0px;
    height: 0px;
}
QComboBox QAbstractItemView {
    border-radius: 6px;
    background-color: {BG_CARD};
    color: {TEXT_PRIMARY};
    padding: 4px;
    outline: none;
}
QComboBox QAbstractItemView::item {
    padding: 8px;
    color: {TEXT_PRIMARY};
    border: none;
    outline: none;
}
QComboBox QAbstractItemView::item:hover {
    background-color: {ACCENT_SELECTION_BG};
    color: {TEXT_PRIMARY};
}
QComboBox QAbstractItemView::item:selected {
    background-color: {ACCENT_SELECTION_BG};
    color: {TEXT_PRIMARY};
}
QComboBox QAbstractItemView::item:focus {
    outline: none;
    border: none;
}

QCheckBox {
    spacing: 8px;
    font-size: 13px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
}
QCheckBox::indicator:unchecked {
    border: 2px solid {BORDER_LIGHT};
    border-radius: 4px;
    background-color: {BG_CARD};
}
QCheckBox::indicator:checked {
    border: 2px solid {ACCENT_PRIMARY};
    border-radius: 4px;
    background-color: {ACCENT_PRIMARY};
}

QFrame#filtersFrame {
    background-color: {BG_CARD};
    border-radius: 10px;
    border: 1px solid {BORDER_LIGHT};
    padding: 15px;
}

QTableWidget {
    border: 1px solid {BORDER_LIGHT};
    border-radius: 8px;
    background-color: {BG_CARD};
    gridline-color: {BORDER_LIGHT};
}
QHeaderView::section {
    background-color: {BG_DIALOG_ALT};
    padding: 8px;
    border: none;
    border-bottom: 1px solid {BORDER_LIGHT};
    font-weight: bold;
}

QLabel#titleLabel {
    font-size: 20px;
    font-weight: bold;
    color: {TEXT_PRIMARY};
    padding: 3px 0;
}

/* Заголовки-подписи и значения в infoFrame — на токенах */
QLabel#label_position_title,
QLabel#label_phone_title,
QLabel#label_email_title,
QLabel#label_birth_date_title,
QLabel#label_dept_type_title {
    font-size: 24px;
    color: {TEXT_MUTED_ALT};
    background-color: transparent;
    font-weight: 500;
}
QLabel#label_position_value,
QLabel#label_phone_value,
QLabel#label_email_value,
QLabel#label_birth_date_value,
QLabel#label_dept_name_value {
    font-size: 24px;
    color: {TEXT_PRIMARY};
    background-color: transparent;
}

QToolButton#btnEditPhone,
QToolButton#btnEditEmail {
    background-color: transparent;
    color: {ACCENT_PRIMARY};
    font-size: 20px;
    border: none;
    border-radius: 8px;
    padding: 4px 12px;
}
QToolButton#btnEditPhone:hover,
QToolButton#btnEditEmail:hover {
    color: {ACCENT_HOVER};
    background-color: {ACCENT_PRIMARY_ALPHA_10};
}
QToolButton#btnEditPhone:pressed,
QToolButton#btnEditEmail:pressed {
    color: {ACCENT_PRESSED_DEEP};
    background-color: {ACCENT_PRIMARY_ALPHA_20};
}

QScrollArea {
    border: none;
    background-color: transparent;
}
QScrollBar:vertical {
    background: {SCROLLBAR_BG};
    width: 8px;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: {SCROLLBAR_HANDLE};
    border-radius: 4px;
    min-height: 20px;
}
QScrollBar:horizontal {
    border: none;
    background: {SCROLLBAR_BG};
    height: 8px;
    margin: 0px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal {
    background: {SCROLLBAR_HANDLE};
    border-radius: 4px;
    min-width: 20px;
}
QScrollBar::add-line, QScrollBar::sub-line {
    border: none;
    background: none;
}

QLabel#labelTotalHoursMy, QLabel#labelTotalHoursAll {
    font-size: 12px;
    font-style: italic;
    color: {TEXT_TERTIARY};
    background-color: transparent;
    padding: 2px 0;
    font-weight: normal;
}
