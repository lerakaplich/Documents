QWidget {
    background-color: #F5F5F7;
    font-family: 'Segoe UI', Arial;
}

/* Вкладки */
QTabWidget::pane {
    border: 1px solid #DEE2E6;
    border-radius: 8px;
    background-color: white;
}
QTabBar::tab {
    background-color: #F8F9FA;
    border: 1px solid #DEE2E6;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 10px 20px;
    margin-right: 5px;
    font-size: 14px;
    font-weight: bold;
    color: black;
}
QTabBar::tab:selected {
    background-color: white;
    border-bottom: 2px solid #ccab6e;
    color: black;
}
QTabBar::tab:hover {
    background-color: #E9ECEF;
    color: black;
}

/* Кнопки */
QPushButton {
    min-height: 41px;
    max-height: 41px;
    border: none;
    border-radius: 10px;
    font-weight: bold;
    padding: 0px 16px;
}

QPushButton#btnAddOvertime {
    background-color: #ccab6e;
    color: white;
    font-size: 16px;
}
QPushButton#btnAddOvertime:hover {
    background-color: #998664;
}
QPushButton#btnAddOvertime:pressed {
    background-color: #7a6a50;
}

QPushButton#btnAddOvertimeAll {
    background-color: #ccab6e;
    color: white;
    font-size: 16px;
}
QPushButton#btnAddOvertimeAll:hover {
    background-color: #998664;
}
QPushButton#btnAddOvertimeAll:pressed {
    background-color: #7a6a50;
}

QPushButton#btnSelectPeriodAll {
    background-color: #1B232A;
    color: white;
    font-size: 14px;
}
QPushButton#btnSelectPeriodAll:hover {
    background-color: #D9D9D6;
    color: black;
}
QPushButton#btnSelectPeriodAll:pressed {
    background-color: #B8B8B5;
}

QPushButton#btnSelectPeriod {
    background-color: #1B232A;
    color: white;
    font-size: 14px;
}
QPushButton#btnSelectPeriod:hover {
    background-color: #D9D9D6;
    color: black;
}
QPushButton#btnSelectPeriod:pressed {
    background-color: #B8B8B5;
}

QPushButton#btnApplyFilters {
    background-color: #1B232A;
    color: white;
    font-size: 14px;
}
QPushButton#btnApplyFilters:hover {
    background-color: #D9D9D6;
    color: black;
}
QPushButton#btnApplyFilters:pressed {
    background-color: #B8B8B5;
}

QPushButton#btnClearFilters {
    background-color: #1B232A;
    color: white;
    font-size: 14px;
}
QPushButton#btnClearFilters:hover {
    background-color: #D9D9D6;
    color: black;
}
QPushButton#btnClearFilters:pressed {
    background-color: #B8B8B5;
}

QPushButton#btnExport {
    background-color: #D22730;
    color: white;
    font-size: 14px;
}
QPushButton#btnExport:hover {
    background-color: #862633;
    color: black;
}
QPushButton#btnExport:pressed {
    background-color: #6a1e29;
}

/* ComboBox */
QComboBox {
    border: 2px solid #E0E0E0;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 14px;
    background-color: white;
    height: 41px;
}
QComboBox:focus {
    border: 2px solid #ccab6e;
}
QComboBox::drop-down {
    border: none;
    padding-right: 10px;
}

/* Таблицы */
QTableWidget {
    border: 1px solid #E0E0E0;
    border-radius: 8px;
    background-color: white;
    gridline-color: #E0E0E0;
}
QTableWidget::item {
    padding: 8px;
}
QHeaderView::section {
    background-color: #F5F5F7;
    padding: 8px;
    border: none;
    border-bottom: 1px solid #E0E0E0;
    font-weight: bold;
}

/* Скроллбары */
QScrollArea {
    border: none;
    background-color: transparent;
}
QScrollBar:vertical {
    background: #F5F5F5;
    width: 8px;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: #C1C1C1;
    border-radius: 4px;
    min-height: 20px;
}
QScrollBar:horizontal {
    border: none;
    background: #F5F5F5;
    height: 8px;
    margin: 0px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal {
    background: #c1c1c1;
    border-radius: 4px;
    min-width: 20px;
}
QScrollBar::add-line, QScrollBar::sub-line {
    border: none;
    background: none;
}
