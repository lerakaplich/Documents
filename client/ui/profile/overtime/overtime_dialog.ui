/* ===== Кнопки ===== */
QPushButton {
    border-radius: 10px;
    background-color: {ACCENT_PRIMARY};
    color: {TEXT_ON_ACCENT};
    border: none;
    font-weight: bold;
    font-size: 13px;
    padding: 8px;
}
QPushButton:hover {
    background-color: {ACCENT_HOVER_SOFT};
}
QPushButton:pressed {
    background-color: {ACCENT_PRESSED_DEEP};
}
QPushButton#btnCancel {
    background-color: {BG_PRESSED_LIGHT};
    color: {TEXT_PRIMARY};
}
QPushButton#btnCancel:hover {
    background-color: {BG_PRESSED_CALENDAR};
}
QPushButton#btnCancel:pressed {
    background-color: {BTN_SECONDARY_PRESSED_BG};
}
