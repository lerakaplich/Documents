QWidget {
    background-color: {BG_CARD};
}
QLabel {
    color: {TEXT_PRIMARY};
}
QLabel[bold="true"] {
    font-weight: bold;
    color: {TEXT_PRIMARY};
}
QComboBox, QTextEdit, QDateEdit, QTimeEdit, QTextBrowser {
    border-radius: 10px;
    border: 1px solid {ACCENT_PRIMARY};
    padding: 5px;
    background-color: {BG_INPUT};
    color: {TEXT_PRIMARY};
}
QComboBox:hover, QTextEdit:hover, QDateEdit:hover, QTimeEdit:hover, QTextBrowser:hover {
    border: 1px solid {ACCENT_HOVER_SOFT};
}
QComboBox:focus, QTextEdit:focus, QDateEdit:focus, QTimeEdit:focus, QTextBrowser:focus {
    border: 2px solid {ACCENT_PRIMARY};
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border: none;
}
QDateEdit::drop-down, QTimeEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border: none;
}
QDateEdit::down-arrow {
    image: url({ICON_ARROW_DOWN_PATH});
    width: 18px;
    height: 18px;
    margin-right: 8px;
}
QTimeEdit::up-button, QTimeEdit::down-button {
    width: 30px;
    border: none;
    background: transparent;
}
QTimeEdit::up-arrow {
    image: url({ICON_ARROW_UP_PATH});
    width: 16px;
    height: 16px;
    margin-right: 6px;
}
QTimeEdit::down-arrow {
    image: url({ICON_ARROW_DOWN_PATH});
    width: 16px;
    height: 16px;
    margin-right: 6px;
}
QComboBox::down-arrow {
    image: url({ICON_ARROW_DOWN_PATH});
    width: 16px;
    height: 16px;
    margin-right: 6px;
}

QComboBox QAbstractItemView {
    border-radius: 6px;
    background-color: {BG_CARD};
    color: {TEXT_PRIMARY};
    padding: 4px;
    outline: none;
    border: 1px solid {ACCENT_PRIMARY};
}
QComboBox QAbstractItemView::item {
    padding: 8px;
    color: {TEXT_PRIMARY};
    border: none;
    outline: none;
}
QComboBox QAbstractItemView::item:hover {
    background-color: {ACCENT_SELECTION_BG};
    color: {TEXT_PRIMARY};
}
QComboBox QAbstractItemView::item:selected {
    background-color: {ACCENT_SELECTION_BG};
    color: {TEXT_PRIMARY};
}
QComboBox QAbstractItemView::item:focus {
    outline: none;
    border: none;
}

/* ===== Календарь ===== */
QCalendarWidget {
    background-color: {BG_CARD};
    border-radius: 8px;
    border: 1px solid {ACCENT_PRIMARY};
}
QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: {BG_CARD};
    color: {TEXT_PRIMARY};
    border-radius: 8px 8px 0 0;
}
QCalendarWidget QWidget {
    background-color: {BG_CARD};
    color: {TEXT_PRIMARY};
}
QCalendarWidget QToolButton#qt_calendar_prevmonth,
QCalendarWidget QToolButton#qt_calendar_nextmonth {
    background-color: transparent;
    color: {TEXT_PRIMARY};
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 16px;
    font-weight: bold;
}
QCalendarWidget QToolButton#qt_calendar_prevmonth:hover,
QCalendarWidget QToolButton#qt_calendar_nextmonth:hover {
    background-color: {ACCENT_SELECTION_BG};
}
QCalendarWidget QToolButton#qt_calendar_prevmonth:pressed,
QCalendarWidget QToolButton#qt_calendar_nextmonth:pressed {
    background-color: {BG_PRESSED_CALENDAR};
}
QCalendarWidget QToolButton#qt_calendar_monthbutton {
    background-color: {BG_CARD};
    color: {TEXT_PRIMARY};
    border: none;
    border-radius: 4px;
    padding: 4px 12px;
    font-weight: bold;
}
QCalendarWidget QToolButton#qt_calendar_monthbutton:hover {
    background-color: {ACCENT_SELECTION_BG};
}
QCalendarWidget QToolButton#qt_calendar_yearbutton {
    background-color: {BG_CARD};
    color: {TEXT_PRIMARY};
    border: none;
    border-radius: 4px;
    padding: 4px 12px;
    font-weight: bold;
}
QCalendarWidget QToolButton#qt_calendar_yearbutton:hover {
    background-color: {ACCENT_SELECTION_BG};
}
QCalendarWidget QMenu {
    background-color: {BG_CARD};
    border: 1px solid {ACCENT_PRIMARY};
    border-radius: 6px;
    color: {TEXT_PRIMARY};
}
QCalendarWidget QMenu::item {
    padding: 6px 20px;
    border-radius: 4px;
}
QCalendarWidget QMenu::item:selected {
    background-color: {ACCENT_SELECTION_BG};
    color: {TEXT_PRIMARY};
}
QCalendarWidget QWidget#qt_calendar_weekday {
    color: {TEXT_ON_ACCENT};
    font-weight: bold;
    background-color: {ACCENT_PRIMARY};
    padding: 4px;
}
QCalendarWidget QToolButton#qt_calendar_day {
    border: none;
    border-radius: 4px;
    padding: 4px;
    color: {TEXT_PRIMARY};
    background-color: transparent;
}
QCalendarWidget QToolButton#qt_calendar_day:hover {
    background-color: {ACCENT_SELECTION_BG};
    color: {TEXT_PRIMARY};
}
QCalendarWidget QToolButton#qt_calendar_day:checked {
    background-color: {ACCENT_PRIMARY};
    color: {TEXT_ON_ACCENT};
    border-radius: 4px;
}
QCalendarWidget QToolButton#qt_calendar_day:checked:hover {
    background-color: {ACCENT_HOVER_SOFT};
}
QCalendarWidget QToolButton#qt_calendar_day:disabled {
    color: {TEXT_DISABLED};
}
QCalendarWidget QToolButton#qt_calendar_day[property="isToday"] {
    background-color: {ACCENT_DANGER};
    color: {TEXT_ON_ACCENT};
    border-radius: 4px;
}
QCalendarWidget QToolButton#qt_calendar_day[property="isToday"]:hover {
    background-color: {ACCENT_DANGER_HOVER};
}
QCalendarWidget QToolButton#qt_calendar_day[property="isToday"]:pressed {
    background-color: {ACCENT_DANGER_PRESSED};
}
QCalendarWidget QToolButton#qt_calendar_day[property="isToday"]:checked {
    background-color: {ACCENT_PRIMARY};
    color: {TEXT_ON_ACCENT};
}
QCalendarWidget QToolButton#qt_calendar_day[property="isToday"]:checked:hover {
    background-color: {ACCENT_HOVER_SOFT};
}

