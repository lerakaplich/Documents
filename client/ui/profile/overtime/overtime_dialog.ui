/* ===== СТИЛИ ДЛЯ КНОПОК ===== */
QPushButton {
    border-radius: 10px;
    background-color: #CCAB6E;
    color: white;
    border: none;
    font-weight: bold;
    font-size: 13px;
    padding: 8px;
}
QPushButton:hover {
