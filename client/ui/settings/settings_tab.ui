                  <string notr="true">
QComboBox, QTextEdit, QDateEdit, QTextBrowser {
border-radius: 10px;
border: 1px solid {ACCENT_PRIMARY};
padding: 5px;
background-color: {BG_INPUT};
color: {TEXT_PRIMARY};
}
QComboBox:hover, QTextEdit:hover, QDateEdit:hover, QTextBrowser:hover {
border: 1px solid {ACCENT_HOVER_SOFT};
}
QComboBox:focus, QTextEdit:focus, QDateEdit:focus, QTextBrowser:focus {
border: 2px solid {ACCENT_PRIMARY};
}

/* Стили для выпадающего контейнера QComboBox */
QComboBox::drop-down {
subcontrol-origin: padding;
subcontrol-position: top right;
width: 30px;
border: none;
}

QComboBox::down-arrow {
image: url({ICON_ARROW_DOWN_PATH});
width: 16px;
height: 16px;
margin-right: 6px;
}

/* ===== ВЫПАДАЮЩИЕ СПИСКИ QComboBox ===== */
QComboBox QAbstractItemView {
border-radius: 6px;
background-color: {BG_CARD};
color: {TEXT_PRIMARY};
padding: 4px;
outline: none;
border: 1px solid {ACCENT_PRIMARY};
}
QComboBox QAbstractItemView::item {
padding: 8px;
color: {TEXT_PRIMARY};
border: none;
outline: none;
}
QComboBox QAbstractItemView::item:hover {
background-color: {ACCENT_SELECTION_BG};
color: {TEXT_PRIMARY};
}
QComboBox QAbstractItemView::item:selected {
background-color: {ACCENT_SELECTION_BG};
color: {TEXT_PRIMARY};
}
QComboBox QAbstractItemView::item:focus {
outline: none;
border: none;
}


