              </property>
              <property name="styleSheet">
               <string notr="true">QCheckBox {
    color: #1B232A;
    font-size: 21px;
    background: transparent;
    spacing: 12px;
border: none;
}

QCheckBox::indicator {
    width: 28px;
    height: 28px;
}

QCheckBox::indicator:unchecked {
    image: url(D:/Documents/client/icons/cb_unchecked.svg);
}

QCheckBox::indicator:checked {
    image: url(D:/Documents/client/icons/cb_checked.svg);
}

QCheckBox::indicator:hover:unchecked {
    image: url(D:/Documents/client/icons/cb_unchecked.svg);
}

QCheckBox::indicator:hover:checked {
    image: url(D:/Documents/client/icons/cb_checked.svg);
}

QCheckBox::indicator:pressed:unchecked {
    image: url(D:/Documents/client/icons/cb_unchecked.svg);
}

QCheckBox::indicator:pressed:checked {
    image: url(D:/Documents/client/icons/cb_checked.svg);
}</string>
