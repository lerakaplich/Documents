   <string notr="true">QDialog {
    background-color: #f8f9fa;
}

QLabel {
    color: #1B232A;
    font-weight: 500;
    font-size: 13px;
}

QDateEdit {
    border: 1px solid #dee2e6;
    border-radius: 6px;
    padding: 8px;
    padding-right: 30px;
    background-color: white;
    color: #1B232A;
    font-size: 13px;
}

QDateEdit:hover {
    border-color: #ccab6e;
}

QDateEdit:focus {
    border: 2px solid #ccab6e;
}

QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border: none;
}

QDateEdit::down-arrow {
    image: url(D:/Documents/client/icons/calendar_date.png);
    width: 20px;
    height: 20px;
    margin-right: 6px;
}

QDateEdit QCalendarWidget {
    background-color: white;
    border-radius: 8px;
    padding: 5px;
}

QDateEdit QCalendarWidget QTableView {
    border: none;
    background-color: white;
}

QDateEdit QCalendarWidget QHeaderView::section {
    background-color: #f8f9fa;
    color: #1B232A;
    font-weight: bold;
    padding: 4px;
    border: none;
}

QDateEdit QCalendarWidget QTableView::item {
    padding: 4px;
    border-radius: 4px;
}

QDateEdit QCalendarWidget QTableView::item:selected {
    background-color: #ccab6e;
    color: white;
}

QDateEdit QCalendarWidget QTableView::item:hover {
    background-color: #e3f2fd;
}

/* Стили для кнопок быстрого выбора (будут переопределены в коде) */
QPushButton#todayButton,
QPushButton#weekButton,
QPushButton#monthButton,
QPushButton#quarterButton {
    background-color: transparent;
    color: #1B232A;
    font-weight: bold;
    font-size: 12px;
    border: none;
    padding: 4px 8px;
}

QPushButton#todayButton:hover,
QPushButton#weekButton:hover,
QPushButton#monthButton:hover,
QPushButton#quarterButton:hover {
    color: #ccab6e;
}

/* Активный стиль будет применяться через код */
/* .active {
    color: #ccab6e;
    text-decoration: underline;
} */

QPushButton#applyButton {
    background-color: #ccab6e;
    color: white;
    border-radius: 8px;
    font-weight: bold;
    font-size: 14px;
    border: none;
    padding: 0 20px;
}

QPushButton#applyButton:hover {
    background-color: #b8945a;
}

QPushButton#applyButton:pressed {
    background-color: #a07d4a;
}

QHBoxLayout, QVBoxLayout {
    spacing: 10px;
}</string>
