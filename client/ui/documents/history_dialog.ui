  <property name="styleSheet">
   <string notr="true">
* {
    font-family: 'Segoe UI', Arial;
}

QDialog {
    background-color: #F5F5F7;
    color: black;
}

/* Белая карточка */
QFrame#contentFrame {
    background-color: white;
    border: 1px solid #E0E0E0;
    border-radius: 12px;
    margin: 6px 8px 6px 8px;
    padding: 16px;
}

/* Заголовок */
QLabel#titleLabel {
    font-size: 20px;
    font-weight: bold;
    color: #1B232A;
    padding: 10px 0px 10px 0px;
    background-color: transparent;
}

QLabel#docInfoLabel {
    font-size: 14px;
    color: #666;
    background-color: transparent;
    padding-bottom: 8px;
}

QLabel#sectionLabel {
    font-size: 14px;
    font-weight: bold;
    color: #333;
    background-color: transparent;
    padding-bottom: 4px;
}

/* Список истории */
QListWidget#historyListWidget {
    border: 1px solid #E0E0E0;
    border-radius: 8px;
    background-color: #FAFAFA;
    color: black;
    font-size: 14px;
    padding: 6px 0px;
    outline: 0;
}

QListWidget#historyListWidget::item {
    padding: 0px;
    margin: 0px;
    background-color: transparent;
}

QListWidget#historyListWidget::item:selected, 
QListWidget#historyListWidget::item:hover, 
QListWidget#historyListWidget::item:active {
    background-color: transparent;
    border: none;
    outline: none;
}

/* Кнопка Закрыть */
QPushButton#closeButton {
    background-color: #1B232A;
    color: white;
    border: none;
    border-radius: 10px;
    padding: 10px 20px;
    font-size: 16px;
    font-weight: bold;
}
QPushButton#closeButton:hover {
    background-color: #D9D9D6;
    color: black;
}
QPushButton#closeButton:pressed {
    background-color: #B8B8B5;
}

/* Вертикальная полоса прокрутки */
QScrollBar:vertical {
    background: #F5F5F5;
    width: 8px;
    border-radius: 4px;
    margin: 0px;
    border: none;
}
QScrollBar::handle:vertical {
    background: #C1C1C1;
    border-radius: 4px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover {
    background: #A0A0A0;
}
QScrollBar::handle:vertical:pressed {
    background: #888888;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    border: none;
    background: none;
    width: 0px;
    height: 0px;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}
   </string>
