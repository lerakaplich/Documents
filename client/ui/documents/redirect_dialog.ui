  <property name="styleSheet">
   <string notr="true">
* {
    font-family: 'Segoe UI', Arial;
}

QDialog {
    background-color: {BG_DIALOG_ALT};
    color: {TEXT_BLACK};
}

QLabel#titleLabel {
    color: {TEXT_PRIMARY};
    font-size: 20px;
    font-weight: bold;
    background-color: transparent;
    padding: 10px 0px 16px 0px;
}

QFrame#contentFrame {
    background-color: {BG_CARD};
    border: 1px solid {BORDER_LIGHT};
    border-radius: 12px;
    padding: 16px;
}

QLabel#instructionLabel,
QLabel#commentLabel {
    font-size: 14px;
    font-weight: bold;
    color: {TEXT_HEADING};
    background-color: transparent;
    padding-bottom: 4px;
}

QLabel#selectionInfoLabel {
    font-size: 13px;
    color: {TEXT_SECONDARY};
    background-color: transparent;
    padding: 4px 0px;
    border: none;
}

QLineEdit#searchEdit {
    border: 1px solid {BORDER_INPUT};
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 14px;
    background-color: {BG_INPUT};
    color: {TEXT_PRIMARY};
    placeholder-text-color: {TEXT_MUTED_ALT};
}
QLineEdit#searchEdit:focus {
    border: 2px solid {ACCENT_DANGER};
}

QTextEdit#commentTextEdit {
    border: 1px solid {BORDER_LIGHT};
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 14px;
    color: {TEXT_PRIMARY};
    background-color: {BG_INPUT};
}
QTextEdit#commentTextEdit:focus {
    border: 2px solid {ACCENT_DANGER};
}

QTreeWidget#treeWidget {
    border: 1px solid {BORDER_LIGHT};
    border-radius: 8px;
    background-color: transparent;
    color: {TEXT_BLACK};
    font-size: 14px;
    padding: 4px;
    outline: none;
}
QTreeWidget#treeWidget::item {
    background-color: transparent;
    padding: 4px 6px;
    color: {TEXT_BLACK};
}
QTreeWidget#treeWidget::item:hover {
    background-color: {BG_HOVER_LIGHT};
    color: {TEXT_BLACK};
}
QTreeWidget#treeWidget QHeaderView::section {
    background-color: {BG_CARD};
    color: {TEXT_PRIMARY};
    border: none;
    border-bottom: 1px solid {BORDER_LIGHT};
    padding: 6px 8px;
    font-weight: bold;
}

QPushButton#btnSearch {
    background-color: {ACCENT_DANGER};
    color: {TEXT_ON_ACCENT};
    border-radius: 8px;
    font-weight: bold;
    padding: 6px 10px;
    font-size: 14px;
    border: none;
}
QPushButton#btnSearch:hover {
    background-color: {ACCENT_DANGER_HOVER};
}
QPushButton#btnSearch:pressed {
    background-color: {ACCENT_DANGER_PRESSED};
}

QPushButton#sendButton {
    background-color: {ACCENT_PRIMARY};
    color: {TEXT_ON_ACCENT};
    border: none;
    border-radius: 10px;
    padding: 10px 20px;
    font-size: 18px;
    font-weight: bold;
    margin-top: 12px;
}
QPushButton#sendButton:hover {
    background-color: {ACCENT_HOVER_SOFT};
}
QPushButton#sendButton:pressed {
    background-color: {ACCENT_PRESSED_DEEP};
}

QScrollBar:vertical {
    background: {SCROLLBAR_BG};
    width: 8px;
    border-radius: 4px;
    margin: 0px;
    border: none;
}
QScrollBar::handle:vertical {
    background: {SCROLLBAR_HANDLE};
    border-radius: 4px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover {
    background: {SCROLLBAR_HANDLE_HOVER};
}
QScrollBar::handle:vertical:pressed {
    background: {SCROLLBAR_HANDLE_PRESSED};
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    border: none;
    background: none;
    width: 0px;
    height: 0px;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}
