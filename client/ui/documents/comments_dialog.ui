    color: {TEXT_HEADING};
    background-color: transparent;
    padding-bottom: 4px;
}

QListWidget {
    border: 1px solid {ACCENT_PRIMARY};
    border-radius: 8px;
    background-color: {BG_SURFACE_SUBTLE};
    color: {TEXT_BLACK};
    font-size: 14px;
    padding: 6px 0px;
    outline: 0;
}
QListWidget::item {
    padding: 0px;
    margin: 0px;
    background-color: transparent;
}
QListWidget::item:selected,
QListWidget::item:hover,
QListWidget::item:active {
    background-color: transparent;
    border: none;
    outline: none;
}

QTextEdit {
    border: 1px solid {ACCENT_PRIMARY};
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 14px;
    color: {TEXT_BLACK};
    background-color: {BG_INPUT};
}
QTextEdit:focus {
    border: 2px solid {ACCENT_DANGER};
}

QLineEdit {
    border: 1px solid {ACCENT_PRIMARY};
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 14px;
    background-color: {BG_INPUT};
    color: {TEXT_PRIMARY};
}
QLineEdit:focus {
    border: 2px solid {ACCENT_DANGER};
}
QLineEdit:disabled {
    background-color: {BG_INPUT_READONLY};
    color: {TEXT_TERTIARY};
}

QPushButton#sendButton {
    background-color: {ACCENT_PRIMARY};
    color: {TEXT_ON_ACCENT};
    border: none;
    border-radius: 10px;
    padding: 10px 20px;
    font-size: 16px;
    font-weight: bold;
}
QPushButton#sendButton:hover {
    background-color: {ACCENT_HOVER_SOFT};
}
QPushButton#sendButton:pressed {
    background-color: {ACCENT_PRESSED_DEEP};
}

QPushButton#closeButton {
    background-color: {BTN_DARK_BG};
    color: {TEXT_ON_ACCENT};
    border: none;
    border-radius: 10px;
    padding: 10px 20px;
    font-size: 16px;
    font-weight: bold;
}
QPushButton#closeButton:hover {
    background-color: {BTN_DARK_HOVER_BG};
    color: {TEXT_BLACK};
}
QPushButton#closeButton:pressed {
    background-color: {BTN_DARK_PRESSED_BG};
}

QLabel#timeLabel {
    color: {TEXT_TERTIARY};
    font-size: 11px;
    background-color: transparent;
}

QScrollBar:vertical {
    background: {SCROLLBAR_BG};
    width: 8px;
    border-radius: 4px;
    margin: 0px;
    border: none;
}
QScrollBar::handle:vertical {
    background: {SCROLLBAR_HANDLE};
    border-radius: 4px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover { background: {SCROLLBAR_HANDLE_HOVER}; }
QScrollBar::handle:vertical:pressed { background: {SCROLLBAR_HANDLE_PRESSED}; }
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    border: none; background: none; width: 0px; height: 0px;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical { background: none; }
