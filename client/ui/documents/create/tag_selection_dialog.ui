  <property name="styleSheet">
   <string notr="true">* {
    font-family: 'Segoe UI', Arial;
}

QDialog {
    background-color: {BG_DIALOG_ALT};
    color: {TEXT_BLACK};
}

QLabel#titleLabel {
    color: {TEXT_PRIMARY};
    font-size: 20px;
    font-weight: bold;
    background-color: transparent;
    padding: 10px 0px 16px 0px;
}

QFrame#contentFrame {
    background-color: {BG_CARD};
    border: 1px solid {BORDER_LIGHT};
    border-radius: 12px;
    padding: 16px;
}

QLabel#instructionLabel {
    font-size: 14px;
    font-weight: bold;
    color: {TEXT_HEADING};
    background-color: transparent;
    padding-bottom: 4px;
}

QLabel#selectionInfoLabel {
    font-size: 13px;
    color: {TEXT_SECONDARY};
    background-color: transparent;
    padding: 4px 0px;
    border: none;
}

QLineEdit#searchEdit {
    border: 1px solid {BORDER_INPUT};
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 14px;
    background-color: {BG_INPUT};
}
QLineEdit#searchEdit:focus {
    border: 2px solid {ACCENT_DANGER};
}

QTreeWidget#treeWidget {
    border: 1px solid {BORDER_LIGHT};
    border-radius: 8px;
    background-color: transparent;
    color: {TEXT_BLACK};
    font-size: 14px;
    padding: 4px;
    outline: none;
}
QTreeWidget#treeWidget::item {
    padding: 8px 6px;
    color: {TEXT_BLACK};
}
QTreeWidget#treeWidget::item:selected {
    background-color: {ACCENT_PRIMARY};
    color: {TEXT_ON_ACCENT};
}
QTreeWidget#treeWidget::item:hover {
    background-color: {BG_HOVER_LIGHT};
    color: {TEXT_BLACK};
}

/* Стили для чекбоксов */
QTreeWidget#treeWidget::indicator {
    width: 18px;
    height: 18px;
}

QTreeWidget#treeWidget QHeaderView::section {
    background-color: {BG_CARD};
    color: {TEXT_PRIMARY};
    border: none;
    border-bottom: 1px solid {BORDER_LIGHT};
    padding: 6px 8px;
    font-weight: bold;
}

QPushButton#selectButton {
    background-color: {ACCENT_PRIMARY};
    color: {TEXT_ON_ACCENT};
    border: none;
    border-radius: 10px;
    padding: 10px 20px;
    font-size: 18px;
    font-weight: bold;
    margin-top: 12px;
}
QPushButton#selectButton:hover {
    background-color: {ACCENT_HOVER_SOFT};
}
QPushButton#selectButton:pressed {
    background-color: {ACCENT_PRESSED_DEEP};
}

QPushButton#cancelButton {
    background-color: transparent;
    color: {TEXT_MUTED};
    border: 1px solid {BORDER_INPUT};
    border-radius: 10px;
    padding: 10px 20px;
    font-size: 18px;
    font-weight: bold;
    margin-top: 12px;
}
QPushButton#cancelButton:hover {
    background-color: {BG_HOVER_LIGHT};
    border-color: {BORDER_HOVER};
}
QPushButton#cancelButton:pressed {
    background-color: {BG_PRESSED_LIGHT};
}

QScrollBar:vertical {
    background: {SCROLLBAR_BG};
    width: 8px;
    border-radius: 4px;
    margin: 0px;
    border: none;
}
QScrollBar::handle:vertical {
    background: {SCROLLBAR_HANDLE};
    border-radius: 4px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover {
    background: {SCROLLBAR_HANDLE_HOVER};
}
QScrollBar::handle:vertical:pressed {
    background: {SCROLLBAR_HANDLE_PRESSED};
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    border: none;
    background: none;
    width: 0px;
    height: 0px;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}</string>
