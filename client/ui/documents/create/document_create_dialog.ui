   <string notr="true">
QWidget {
    background-color: {BG_CARD};
}
QLabel {
    color: {TEXT_PRIMARY};
}
QLabel[bold="true"] {
    font-weight: bold;
    color: {TEXT_PRIMARY};
}
QComboBox, QTextEdit, QDateEdit, QTextBrowser {
    border-radius: 10px;
    border: 1px solid {ACCENT_PRIMARY};
    padding: 5px;
    background-color: {BG_INPUT};
    color: {TEXT_PRIMARY};
}
QComboBox:hover, QTextEdit:hover, QDateEdit:hover, QTextBrowser:hover {
    border: 1px solid {ACCENT_HOVER_SOFT};
}
QComboBox:focus, QTextEdit:focus, QDateEdit:focus, QTextBrowser:focus {
    border: 2px solid {ACCENT_PRIMARY};
}

/* Стили для выпадающего контейнера QComboBox */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border: none;
}

/* Настройки зоны drop-down для QDateEdit */
QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border: none;
}

/* Иконка календаря вместо стрелочки */
QDateEdit::down-arrow {
    image: url({ICON_CALENDAR_PATH});
    width: 18px;
    height: 18px;
    margin-right: 8px;
}
QComboBox::down-arrow {
    image: url({ICON_ARROW_DOWN_PATH});
    width: 16px;
    height: 16px;
    margin-right: 6px;
}


/* ===== КНОПКИ С ПЛЮСОМ ===== */
QPushButton#btnAddSender, QPushButton#btnAddExecutor,
QPushButton#btnAddReceiver, QPushButton#btnAddTag {
    border-radius: 18px;
    background-color: {ACCENT_PRIMARY};
    border: none;
    min-width: 36px;
    min-height: 36px;
    max-width: 36px;
    max-height: 36px;
    padding: 0px;
}
QPushButton#btnAddSender:hover, QPushButton#btnAddExecutor:hover,
QPushButton#btnAddReceiver:hover, QPushButton#btnAddTag:hover {
    background-color: {ACCENT_HOVER_SOFT};
}
QPushButton#btnAddSender:pressed, QPushButton#btnAddExecutor:pressed,
QPushButton#btnAddReceiver:pressed, QPushButton#btnAddTag:pressed {
    background-color: {ACCENT_PRESSED_DEEP};
}
QPushButton#btnAddSender::icon, QPushButton#btnAddExecutor::icon,
QPushButton#btnAddReceiver::icon, QPushButton#btnAddTag::icon {
    width: 24px;
    height: 24px;
}
QPushButton#btnAddSender::icon:hover, QPushButton#btnAddExecutor::icon:hover,
QPushButton#btnAddReceiver::icon:hover, QPushButton#btnAddTag::icon:hover {
    background-color: transparent;
}

/* ===== КНОПКИ-ВЫБОРЫ (отправитель / получатель / исполнитель / теги) ===== */
QPushButton#btn_sender, QPushButton#btn_receiver,
QPushButton#btnExecutor, QPushButton#btn_tag {
    border-radius: 10px;
    border: 1px solid {ACCENT_PRIMARY};
    padding: 5px;
    text-align: left;
    background-color: {BG_INPUT};
    color: {TEXT_PRIMARY};
}
QPushButton#btn_sender:hover, QPushButton#btn_receiver:hover,
QPushButton#btnExecutor:hover, QPushButton#btn_tag:hover {
    border: 1px solid {ACCENT_HOVER_SOFT};
    background-color: {BG_HOVER_ACCENT_SOFT};
}
QPushButton#btn_sender:focus, QPushButton#btn_receiver:focus,
QPushButton#btnExecutor:focus, QPushButton#btn_tag:focus {
    border: 2px solid {ACCENT_PRIMARY};
}

/* ===== КНОПКА СОХРАНЕНИЯ ===== */
QPushButton#btn_attach {
    border-radius: 10px;
    background-color: {ACCENT_PRIMARY};
    color: {TEXT_ON_ACCENT};
    border: none;
    font-weight: bold;
    font-size: 13px;
}
QPushButton#btn_attach:hover {
    background-color: {ACCENT_HOVER_SOFT};
}
QPushButton#btn_attach:pressed {
    background-color: {ACCENT_PRESSED_DEEP};
}

/* ===== ВЫПАДАЮЩИЕ СПИСКИ QComboBox ===== */
QComboBox QAbstractItemView {
    border-radius: 6px;
    background-color: {BG_CARD};
    color: {TEXT_PRIMARY};
    padding: 4px;
    outline: none;
    border: 1px solid {ACCENT_PRIMARY};
}
QComboBox QAbstractItemView::item {
    padding: 8px;
    color: {TEXT_PRIMARY};
    border: none;
    outline: none;
}
QComboBox QAbstractItemView::item:hover {
    background-color: {ACCENT_SELECTION_BG};
    color: {TEXT_PRIMARY};
}
QComboBox QAbstractItemView::item:selected {
    background-color: {ACCENT_SELECTION_BG};
    color: {TEXT_PRIMARY};
}
QComboBox QAbstractItemView::item:focus {
    outline: none;
    border: none;
}

/* ===== КАЛЕНДАРЬ QCalendarWidget ===== */
QCalendarWidget {
    background-color: {BG_CARD};
    border-radius: 8px;
    border: 1px solid {ACCENT_PRIMARY};
}
QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: {BG_CARD};
    color: {TEXT_PRIMARY};
    border-radius: 8px 8px 0 0;
}
QCalendarWidget QWidget {
    background-color: {BG_CARD};
    color: {TEXT_PRIMARY};
}
QCalendarWidget QToolButton#qt_calendar_prevmonth,
QCalendarWidget QToolButton#qt_calendar_nextmonth {
    background-color: transparent;
    color: {TEXT_PRIMARY};
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 16px;
    font-weight: bold;
}
QCalendarWidget QToolButton#qt_calendar_prevmonth:hover,
QCalendarWidget QToolButton#qt_calendar_nextmonth:hover {
    background-color: {ACCENT_SELECTION_BG};
}
QCalendarWidget QToolButton#qt_calendar_prevmonth:pressed,
QCalendarWidget QToolButton#qt_calendar_nextmonth:pressed {
    background-color: {BG_PRESSED_CALENDAR};
}
QCalendarWidget QToolButton#qt_calendar_monthbutton {
    background-color: {BG_CARD};
    color: {TEXT_PRIMARY};
    border: none;
    border-radius: 4px;
    padding: 4px 12px;
    font-weight: bold;
}
QCalendarWidget QToolButton#qt_calendar_monthbutton:hover {
    background-color: {ACCENT_SELECTION_BG};
}
QCalendarWidget QToolButton#qt_calendar_yearbutton {
    background-color: {BG_CARD};
    color: {TEXT_PRIMARY};
    border: none;
    border-radius: 4px;
    padding: 4px 12px;
    font-weight: bold;
}
QCalendarWidget QToolButton#qt_calendar_yearbutton:hover {
    background-color: {ACCENT_SELECTION_BG};
}
QCalendarWidget QMenu {
    background-color: {BG_CARD};
    border: 1px solid {ACCENT_PRIMARY};
    border-radius: 6px;
    color: {TEXT_PRIMARY};
}
QCalendarWidget QMenu::item {
    padding: 6px 20px;
    border-radius: 4px;
}
QCalendarWidget QMenu::item:selected {
    background-color: {ACCENT_SELECTION_BG};
    color: {TEXT_PRIMARY};
}
QCalendarWidget QWidget#qt_calendar_weekday {
    color: {TEXT_ON_ACCENT};
    font-weight: bold;
    background-color: {ACCENT_PRIMARY};
    padding: 4px;
}
QCalendarWidget QToolButton#qt_calendar_day {
    border: none;
    border-radius: 4px;
    padding: 4px;
    color: {TEXT_PRIMARY};
    background-color: transparent;
}
QCalendarWidget QToolButton#qt_calendar_day:hover {
    background-color: {ACCENT_SELECTION_BG};
    color: {TEXT_PRIMARY};
}
QCalendarWidget QToolButton#qt_calendar_day:checked {
    background-color: {ACCENT_PRIMARY};
    color: {TEXT_ON_ACCENT};
    border-radius: 4px;
}
QCalendarWidget QToolButton#qt_calendar_day:checked:hover {
    background-color: {ACCENT_HOVER_SOFT};
}
QCalendarWidget QToolButton#qt_calendar_day:disabled {
    color: {TEXT_DISABLED};
}
QCalendarWidget QToolButton#qt_calendar_day[property="isToday"] {
    background-color: {ACCENT_DANGER};
    color: {TEXT_ON_ACCENT};
    border-radius: 4px;
}
QCalendarWidget QToolButton#qt_calendar_day[property="isToday"]:hover {
    background-color: {ACCENT_DANGER_HOVER};
}
QCalendarWidget QToolButton#qt_calendar_day[property="isToday"]:pressed {
    background-color: {ACCENT_DANGER_PRESSED};
}
QCalendarWidget QToolButton#qt_calendar_day[property="isToday"]:checked {
    background-color: {ACCENT_PRIMARY};
    color: {TEXT_ON_ACCENT};
}
QCalendarWidget QToolButton#qt_calendar_day[property="isToday"]:checked:hover {
    background-color: {ACCENT_HOVER_SOFT};
}

