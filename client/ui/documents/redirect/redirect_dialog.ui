  <property name="styleSheet">
   <string notr="true">
* {
    font-family: 'Segoe UI', Arial;
}

QDialog {
    background-color: #F5F5F7;
    color: black;
}

/* Красная шапка */
QFrame#headerFrame {
    background-color: #D22730;
    margin: 0px;
    padding: 0px;
    border: none;
}



QLabel#titleLabel {
    color: white;
    font-size: 20px;
    font-weight: bold;
    background-color: transparent;
    padding: 10px;
	color: black;
}

/* Белая карточка */
QFrame#contentFrame {
    background-color: white;
    border: 1px solid #E0E0E0;
    border-radius: 12px;
    margin: 6px 8px 6px 8px;
    padding: 16px;
}

/* Поясняющие надписи */
QLabel#instructionLabel {
    font-size: 14px;
    font-weight: bold;
    color: #333;
    background-color: transparent;
    padding-bottom: 4px;
}
QLabel#commentLabel {
    font-size: 14px;
    font-weight: bold;
    color: #333;
    background-color: transparent;
    padding-bottom: 4px;
}

/* Поле поиска */


QLineEdit {
    border: 1px solid #D0D0D0;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 14px;
    background-color: white;
}
QLineEdit:focus {
    border: 2px solid #D22730;
}


/* Список сотрудников */
QListWidget {
    border: 1px solid #E0E0E0;
    border-radius: 8px;
    background-color: white;
    color: black;
    font-size: 15px;
    padding: 4px;
}
QListWidget::item {
    padding: 8px 6px;
}
QListWidget::item:selected {
    background-color: #ccab6e;
    color: white;
border: none;
}

/* Поле комментария */
QTextEdit {
    border: 1px solid #E0E0E0;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 14px;
    color: black;
    background-color: white;
}
QTextEdit:focus {
border: 2px solid #D22730;
}


/* Кнопка Отправить (золотая) */
QPushButton#sendButton {
    background-color: #ccab6e;
    color: white;
    border: none;
    border-radius: 10px;
    padding: 10px 20px;
    font-size: 18px;
    font-weight: bold;
}
QPushButton#sendButton:hover {
    background-color: #998664;
}
QPushButton#sendButton:pressed {
    background-color: #7a6a50;
}
/* Вертикальная полоса прокрутки */
            QScrollBar:vertical {
                background: #F5F5F5;
                width: 8px;
                border-radius: 4px;
                margin: 0px;
                border: none;
            }

            QScrollBar::handle:vertical {
                background: #C1C1C1;
                border-radius: 4px;
                min-height: 20px;
            }

            QScrollBar::handle:vertical:hover {
                background: #A0A0A0;
            }

            QScrollBar::handle:vertical:pressed {
                background: #888888;
            }

            QScrollBar::add-line:vertical,
            QScrollBar::sub-line:vertical {
                border: none;
                background: none;
                width: 0px;
                height: 0px;
            }

            QScrollBar::add-page:vertical,
            QScrollBar::sub-page:vertical {
                background: none;
            }
   </string>
