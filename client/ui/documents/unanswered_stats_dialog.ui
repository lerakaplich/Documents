}

QTableWidget#statsTable {
    background-color: {BG_CARD};
    color: {TEXT_PRIMARY};
    gridline-color: {TABLE_GRID};
    border: 1px solid {BORDER_LIGHT};
    border-radius: 8px;
    font-size: 14px;
    outline: 0;
}
QTableWidget#statsTable::item {
    padding: 4px 6px;
}
QTableWidget#statsTable::item:selected {
    background-color: {TABLE_SELECTION_BG};
    color: {TABLE_SELECTION_TEXT};
}

QHeaderView::section {
    background-color: {TABLE_HEADER_BG};
    color: {TABLE_HEADER_TEXT};
    padding: 8px;
    border: none;
    border-right: 1px solid {TABLE_HEADER_BORDER};
    border-bottom: 2px solid {TABLE_HEADER_BORDER};
    font-weight: bold;
    font-size: 13px;
}

QPushButton {
    background-color: {ACCENT_PRIMARY};
    color: {TEXT_ON_ACCENT};
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    padding: 0px 20px;
}
QPushButton:hover {
    background-color: {ACCENT_HOVER};
}
QPushButton:pressed {
    background-color: {ACCENT_PRESSED};
}

QScrollBar:vertical {
    background: {SCROLLBAR_BG};
    width: 8px;
    border-radius: 4px;
    margin: 0px;
    border: none;
}
QScrollBar::handle:vertical {
    background: {SCROLLBAR_HANDLE};
    border-radius: 4px;
    min-height: 20px;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    border: none;
    background: none;
    width: 0px;
    height: 0px;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}
